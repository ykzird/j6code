# Optional: J6 Connect source builds
# `cp .env.example .env` enables J6 Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
J6CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
J6CODE_CLERK_JWT_TEMPLATE=j6-relay
J6CODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in J6CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# J6CODE_APPLE_TEAM_ID=ABC1234567
# J6CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/j6code.provisionprofile
# J6CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
J6CODE_RELAY_URL=https://relay.j6code

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://github.com/ykzird/j6code; override to test against a staging deployment.
# J6CODE_HOSTED_APP_URL=https://nightly.github.com/ykzird/j6code

# Public, ingest-only mobile OpenTelemetry configuration.
# J6CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# J6CODE_MOBILE_OTLP_TRACES_DATASET=j6-code-mobile-traces-dev
# J6CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
